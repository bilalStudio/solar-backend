# Backend environment variables
# These override the defaults in application.properties

# ─── Database (defaults to Supabase Postgres) ───
# DB_URL=jdbc:postgresql://localhost:5432/wattvue
# DB_USERNAME=postgres
# DB_PASSWORD=your_password

# ─── JWT ───
# JWT_SECRET=your-secure-secret-string-at-least-32-chars

# ─── Email (Gmail SMTP) ───
# To enable password reset / report emails:
# 1. Enable 2FA on your Gmail account
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# 3. Run npm install in solar-backend so Nodemailer is available
# 4. Set the values below
# MAIL_TRANSPORT=nodemailer
# MAIL_USERNAME=yourname@gmail.com
# MAIL_PASSWORD=your_16_char_app_password
# MAIL_FROM=yourname@gmail.com

# ─── Google OAuth (optional) ───
# Get a client ID at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── Frontend URL (for password reset links) ───
FRONTEND_URL=http://localhost:5173

# ─── CORS ───
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Server ───
# PORT=8080
